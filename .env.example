# Server-only. Never place these values in reel.html or commit a real .env file.
# Production on Vercel uses its automatic OIDC identity with AI Gateway.
# Optional override of the Gateway GPT model:
REEL_AI_MODEL=openai/gpt-4.1-mini
# Optional static Gateway key for non-Vercel hosting:
AI_GATEWAY_API_KEY=
# Optional direct OpenAI fallback for non-Vercel hosting:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional comma-separated Supabase Auth UUID allowlist. Empty permits any signed-in Reel user.
REEL_AI_ALLOWED_USER_IDS=
SUPABASE_URL=https://zwedeotmsmtfkshxeezn.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Vr6DqmUCRgtlB8j10JAvYg_EelZsKgh
